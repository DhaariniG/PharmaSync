# Anything hitting the project root is sent to public/, so app/, config/,
# database/ and storage/ are never reachable from a browser.
#
# This is a real redirect, not an internal rewrite, so the address bar always
# ends up on .../public. That matters: BASE_URL is worked out from the path
# of index.php, and links break if the browser is on one path while PHP
# thinks it is on another.
RewriteEngine On

# Already inside public/: leave it to public/.htaccess.
RewriteRule ^public/ - [L]

# Work out this folder's URL without writing its name here, so the project
# works in any folder. $1 is the path after this folder (e.g. "admin/x").
# REQUEST_URI is the full path (e.g. "/PharmaSync/admin/x"). Whatever comes
# before $1 in REQUEST_URI is this folder's URL, captured as %1
# ("/PharmaSync/"). Without this, Apache would put the folder's disk path
# (C:/xampp/htdocs/...) into the redirect.
RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
RewriteRule ^(.*)$ %1public/$1 [R=302,L]
